{
  "name": "meroro",
  "productName": "Meroro",
  "version": "1.1.0",
  "description": "Meroro \u2014 phone streaming studio by Kartik Sabale. Mirror an Android phone or a single app and go live on YouTube.",
  "author": "Kartik Sabale",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fetch-bins.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:mac": "npm run build && electron-builder --mac -c.electronDist=node_modules/electron/dist",
    "dist:win": "node scripts/fetch-bins.mjs win && npm run build && electron-builder --win --x64",
    "pack": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.meroro.studio",
    "productName": "Meroro",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "bin/${os}",
        "to": "bin"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Meroro uses the camera for your webcam overlay.",
        "NSMicrophoneUsageDescription": "Meroro uses the microphone for your stream audio.",
        "NSLocalNetworkUsageDescription": "Meroro connects to your Android phone over Wi-Fi (wireless debugging).",
        "NSBonjourServices": [
          "_adb._tcp",
          "_adb-tls-connect._tcp",
          "_adb-tls-pairing._tcp"
        ]
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "copyright": "\u00a9 2026 Kartik Sabale",
    "dmg": {
      "title": "Meroro"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
